<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <!-- xUnit v3 test projects are stand-alone executables running on
         Microsoft Testing Platform (dotnet test mode is set in /global.json) -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Haru\Haru.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*" />
    <!-- Fonts are loaded from streams (the embedded resources) and from files by the font API -->
    <None Update="Resources\Fonts\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
