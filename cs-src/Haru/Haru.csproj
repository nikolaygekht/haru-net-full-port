<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Haru</RootNamespace>
    <AssemblyName>Haru</AssemblyName>
    <LangVersion>latest</LangVersion>

    <PackageId>Haru</PackageId>
    <Version>1.1.1</Version>
    <Authors>Gehtsoft USA LLC</Authors>
    <Company>Gehtsoft USA LLC</Company>
    <Product>Haru PDF Library - Pure C# Port</Product>
    <Description>Pure C# port of libharu PDF generation library. No native dependencies required.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/nikolaygekht/haru-net-full-port</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nikolaygekht/haru-net-full-port</RepositoryUrl>
    <Copyright>Copyright (c) 2016-2026 Nikolay Gekht</Copyright>
    <PackageTags>pdf;haru;libharu;pdf-generation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <!-- CodePagesEncodingProvider is part of the shared framework (.NET 8 and later); no System.Text.Encoding.CodePages package needed -->
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Font\CID\Data\*.json" />
    <EmbeddedResource Include="Doc\Icc\sRGB-v2-micro.icc" LogicalName="Haru.Icc.sRGB-v2-micro.icc" />
  </ItemGroup>

</Project>
